<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<title>Área de Membros</title>
</head>
<body>

<h2>Área exclusiva para membros</h2>

<input type="password" id="senha" placeholder="Digite a senha">
<button onclick="verificar()">Entrar</button>

<div id="conteudo" style="display:none;">
    <h3>Conteúdo exclusivo</h3>
    <p>Aqui entra o material só para membros.</p>
</div>

<script>
function verificar() {
    const senhaCorreta = "tomasi123"; // tu define
    const digitada = document.getElementById("senha").value;

    if (digitada === senhaCorreta) {
        document.getElementById("conteudo").style.display = "block";
    } else {
        alert("Senha incorreta");
    }
}
</script>

</body>
</html>
